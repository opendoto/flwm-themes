! -----------------------------------------------------------------------------
!                                   Nord Dark
! -----------------------------------------------------------------------------
! Note: Run 'filetool.sh -b' after editing to persist changes across reboots.

! --- ATERM CONFIG ---
! Controls the terminal scrollbar visibility (set to true to show)
Aterm*scrollBar:        false

! Transparency settings (set 'transparent' to true to enable window opacity)
Aterm*transparent:      false
Aterm*shading:          80

! Basic terminal window settings like default title, font style, and history buffer
Aterm*title:            Terminal
Aterm*font:             fixed
Aterm*saveLines:        2000

! Main text and background colors for the terminal window canvas
Aterm*background:       #2e3440
Aterm*foreground:       #d8dee9
Aterm*cursorColor:      #88c0d0
Aterm*pointerColor:     #88c0d0

! Standard ANSI colors (0-7) used for base text highlighting in CLI apps
Aterm*color0:           #3b4252
Aterm*color1:           #bf616a
Aterm*color2:           #a3be8c
Aterm*color3:           #ebcb8b
Aterm*color4:           #81a1c1
Aterm*color5:           #b48ead
Aterm*color6:           #88c0d0
Aterm*color7:           #e5e9f0

! Bright ANSI colors (8-15) used for bold or high-intensity terminal outputs
Aterm*color8:           #4c566a
Aterm*color9:           #bf616a
Aterm*color10:          #a3be8c
Aterm*color11:          #ebcb8b
Aterm*color12:          #81a1c1
Aterm*color13:          #b48ead
Aterm*color14:          #8fbcbb
Aterm*color15:          #eceff4

! --- FLTK APPS & SYSTEM UTILITIES ---
! Widget look and feel engine and scaling settings
fltk*scheme:            plastic
*scheme:                plastic
Xft.dpi:                96.0
Xft.antialias:          1
Xft.hinting:            1
*font:                  helvetica-12

! Global background, text, and label colors across FLTK window surfaces
*background:            #3b4252
*foreground:            #e5e9f0
*labelcolor:            #e5e9f0

! FLTK canvas background for text editors, browsers, and input fields
*background2:           #2e3440
*bg2:                   #2e3440

! Accent color for selections, marked text, and active controls
*selectColor:           #5e81ac
*selection_color:       #5e81ac

! Universal component overrides (prevents white-outs on Apps, Editor, Help, etc.)
*input*background:      #2e3440
*input*foreground:      #eceff4
*input*font:            courier-12
*Input*background:      #2e3440
*Input*foreground:      #eceff4
*Input*font:            courier-12
*output*background:     #2e3440
*output*foreground:     #eceff4
*output*font:           courier-12
*Output*background:     #2e3440
*Output*foreground:     #eceff4
*Output*font:           courier-12
*text*background:       #2e3440
*text*foreground:       #eceff4
*text*font:             courier-12
*Text*background:       #2e3440
*Text*foreground:       #eceff4
*Text*font:             courier-12
*Text_Display*background: #2e3440
*Text_Display*foreground: #eceff4
*Text_Display*labelcolor: #e5e9f0
*Text_Display*font:     courier-12
*Text_Editor*background:  #2e3440
*Text_Editor*foreground:  #eceff4
*Text_Editor*font:      courier-12
*browser*background:    #2e3440
*browser*foreground:    #eceff4
*browser*font:          helvetica-12
*Browser*background:    #2e3440
*Browser*foreground:    #eceff4
*Browser*font:          helvetica-12
*Hold_Browser*background: #2e3440
*Hold_Browser*foreground: #eceff4
