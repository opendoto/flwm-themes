! -----------------------------------------------------------------------------
!                                  Gruvbox Dark
! -----------------------------------------------------------------------------

! --- ATERM CONFIG ---
! Controls the terminal scrollbar visibility (set to true to show)
Aterm*scrollBar:        false

! Transparency settings (set 'transparent' to true to enable window opacity)
Aterm*transparent:      false
Aterm*shading:          80

! Basic terminal window settings like default title, font style, and history buffer
Aterm*title:            Terminal
Aterm*font:             fixed
Aterm*saveLines:        2000

! Main text and background colors for the terminal window canvas
Aterm*background:       #282828
Aterm*foreground:       #fbf1c7
Aterm*cursorColor:      #fe8019

! Standard ANSI colors (0-7) used for base text highlighting in CLI apps
Aterm*color0:           #3c3836
Aterm*color1:           #cc241d
Aterm*color2:           #98971a
Aterm*color3:           #d79921
Aterm*color4:           #458588
Aterm*color5:           #b16286
Aterm*color6:           #689d6a
Aterm*color7:           #a89984

! Bright ANSI colors (8-15) used for bold or high-intensity terminal outputs
Aterm*color8:           #928374
Aterm*color9:           #fb4934
Aterm*color10:          #b8bb26
Aterm*color11:          #fabd2f
Aterm*color12:          #83a598
Aterm*color13:          #d3869b
Aterm*color14:          #8ec07c
Aterm*color15:          #fbf1c7

! --- FLTK APPS & SYSTEM UTILITIES ---
! Widget look and feel engine and scaling settings
fltk*scheme:            plastic
*scheme:                plastic
Xft.dpi:                96.0

! Global background, text, and label colors across FLTK window surfaces
*background:            #282828
*foreground:            #fbf1c7
*labelcolor:            #fbf1c7

! FLTK canvas background for text editors, browsers, and input fields (gruvbox bg0_h)
*background2:           #1d2021
*bg2:                   #1d2021

! Accent color for selections, marked text, and active controls (gruvbox orange)
*selectColor:           #fe8019
*selection_color:       #fe8019

! Universal component overrides (Dual TitleCase declarations for strict FLTK class parser)
*input*background:      #1d2021
*input*foreground:      #fbf1c7
*Input*background:      #1d2021
*Input*foreground:      #fbf1c7
*output*background:     #1d2021
*output*foreground:     #fbf1c7
*Output*background:     #1d2021
*Output*foreground:     #fbf1c7
*text*background:       #1d2021
*text*foreground:       #fbf1c7
*Text*background:       #1d2021
*Text*foreground:       #fbf1c7
*browser*background:    #1d2021
*browser*foreground:    #fbf1c7
*Browser*background:    #1d2021
*Browser*foreground:    #fbf1c7
*Hold_Browser*background: #1d2021
*Hold_Browser*foreground: #fbf1c7
*Select_Browser*background: #1d2021
*Select_Browser*foreground: #fbf1c7
*help*background:       #1d2021
*help*foreground:       #fbf1c7
*Help_View*background:  #1d2021
*Help_View*foreground:  #fbf1c7
*file_chooser*background: #282828
*file_chooser*foreground: #fbf1c7
*File_Chooser*background: #282828
*File_Chooser*foreground: #fbf1c7
*scrollbar*background:  #282828
*scrollbar*foreground:  #fbf1c7
*Scrollbar*background:  #282828
*Scrollbar*foreground:  #fbf1c7
*Scrollbar*color:       #3c3836
*Button*background:     #3c3836
*Button*foreground:     #fbf1c7

! --- FLWM ---
! Window manager frames, borders, and titlebar color tones
flwm*background:        #3c3836
flwm*foreground:        #d5c4a1
flwm*activeBackground:  #fabd2f
flwm*activeForeground:  #1d2021
