! -----------------------------------------------------------------------------
!                            Unix CDE (Magenta Frame)
! -----------------------------------------------------------------------------

! --- ATERM CONFIG ---
! Controls the terminal scrollbar visibility (set to true to show)
Aterm*scrollBar:        false

! Transparency settings (set 'transparent' to true to enable window opacity)
Aterm*transparent:      false
Aterm*shading:          80

! Basic terminal window settings like default title, font style, and history buffer
Aterm*title:            Terminal
Aterm*font:             fixed
Aterm*saveLines:        2000

! Main text and background colors for the terminal window canvas
Aterm*background:       #f5f0f3
Aterm*foreground:       #1c1018
Aterm*cursorColor:      #8c3463

! Standard ANSI colors (0-7) used for base text highlighting in CLI apps
Aterm*color0:           #1c1018
Aterm*color1:           #8c3463
Aterm*color2:           #2b6e54
Aterm*color3:           #987018
Aterm*color4:           #366098
Aterm*color5:           #b84d87
Aterm*color6:           #3f759b
Aterm*color7:           #abb4c3

! Bright ANSI colors (8-15) used for bold or high-intensity terminal outputs
Aterm*color8:           #60525a
Aterm*color9:           #c9365e
Aterm*color10:          #398d6d
Aterm*color11:          #b88a20
Aterm*color12:          #3c81c5
Aterm*color13:          #f7ceeb
Aterm*color14:          #5b7696
Aterm*color15:          #ffffff

! --- FLTK APPS & SYSTEM UTILITIES ---
! Widget look and feel engine and scaling settings
fltk*scheme:            plastic
*scheme:                plastic
Xft.dpi:                96.0

! Global background, text, and label colors across FLTK window surfaces
*background:            #8c3463
*foreground:            #f5f0f3
*labelcolor:            #f5f0f3

! FLTK canvas background for text editors, browsers, and input fields
*background2:           #22141f
*bg2:                   #22141f

! Accent color for selections, marked text, and active controls
*selectColor:           #b84d87
*selection_color:       #b84d87

! Universal component overrides (Dual TitleCase declarations for strict FLTK class parser)
*input*background:      #22141f
*input*foreground:      #ffffff
*Input*background:      #22141f
*Input*foreground:      #ffffff
*output*background:     #22141f
*output*foreground:     #ffffff
*Output*background:     #22141f
*Output*foreground:     #ffffff
*text*background:       #22141f
*text*foreground:       #ffffff
*Text*background:       #22141f
*Text*foreground:       #ffffff
*Text_Display*background: #22141f
*Text_Display*foreground: #ffffff
*Text_Display*labelcolor: #f5f0f3
*Text_Editor*background:  #22141f
*Text_Editor*foreground:  #ffffff
*browser*background:    #22141f
*browser*foreground:    #ffffff
*Browser*background:    #22141f
*Browser*foreground:    #ffffff
*Hold_Browser*background: #22141f
*Hold_Browser*foreground: #ffffff
*Select_Browser*background: #22141f
*Select_Browser*foreground: #ffffff
*help*background:       #22141f
*help*foreground:       #ffffff
*Help_View*background:  #22141f
