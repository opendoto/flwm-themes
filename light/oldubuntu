! -----------------------------------------------------------------------------
!                                 oldubuntu
! -----------------------------------------------------------------------------

! --- ATERM CONFIG ---
! Controls the terminal scrollbar visibility (set to true to show)
Aterm*scrollBar:        false

! Transparency settings (set 'transparent' to true to enable window opacity)
Aterm*transparent:      false
Aterm*shading:          80

! Basic terminal window settings like default title, font style, and history buffer
Aterm*title:            Terminal
Aterm*font:             fixed
Aterm*saveLines:        2000

! Main text and background colors for the terminal window canvas
Aterm*background:       #300a24
Aterm*foreground:       #f4ebe3
Aterm*cursorColor:      #f15334

! Standard ANSI colors (0-7) used for base text highlighting in CLI apps
Aterm*color0:           #140a14
Aterm*color1:           #bc2909
Aterm*color2:           #44714e
Aterm*color3:           #ecc484
Aterm*color4:           #3d77ac
Aterm*color5:           #842c7c
Aterm*color6:           #6a92a6
Aterm*color7:           #eceae1

! Bright ANSI colors (8-15) used for bold or high-intensity terminal outputs
Aterm*color8:           #6c6e69
Aterm*color9:           #cc7c5a
Aterm*color10:          #9ad2a0
Aterm*color11:          #eac89e
Aterm*color12:          #8eaacc
Aterm*color13:          #e2b6d4
Aterm*color14:          #b1d0dc
Aterm*color15:          #ffffff

! --- FLTK APPS & SYSTEM UTILITIES ---
! Widget look and feel engine and scaling settings
fltk*scheme:            plastic
*scheme:                plastic
Xft.dpi:                96.0

! Global background, text, and label colors across FLTK window surfaces
*background:            #e5ddcc
*foreground:            #11070e
*labelcolor:            #11070e

! FLTK canvas background for text editors, browsers, and input fields
*background2:           #fcf2e8
*bg2:                   #fcf2e8

! Accent color for selections, marked text, and active controls
*selectColor:           #cc7c5a
*selection_color:       #cc7c5a

! Universal component overrides (Dual TitleCase declarations for strict FLTK class parser)
*input*background:      #fcf2e8
*input*foreground:      #11070e
*Input*background:      #fcf2e8
*Input*foreground:      #11070e
*output*background:     #eee6d4
*output*foreground:     #11070e
*Output*background:     #eee6d4
*Output*foreground:     #11070e
*text*background:       #fcf2e8
*text*foreground:       #11070e
*Text*background:       #fcf2e8
*Text*foreground:       #11070e
*browser*background:    #fcf2e8
*browser*foreground:    #11070e
*Browser*background:    #fcf2e8
*Browser*foreground:    #11070e
*Hold_Browser*background: #fcf2e8
*Hold_Browser*foreground: #11070e
*Select_Browser*background: #fcf2e8
*Select_Browser*foreground: #11070e
*help*background:       #fcf2e8
*help*foreground:       #11070e
*Help_View*background:  #fcf2e8
*Help_View*foreground:  #11070e
*file_chooser*background: #e5ddcc
*file_chooser*foreground: #11070e
*File_Chooser*background: #e5ddcc
*File_Chooser*foreground: #11070e
*scrollbar*background:  #e5ddcc
*scrollbar*foreground:  #11070e
*Scrollbar*background:  #e5ddcc
*Scrollbar*foreground:  #11070e
*Scrollbar*color:       #eee6d4
*Button*background:     #eee6d4
*Button*foreground:     #11070e

! --- FLWM ---
! Window manager frames, borders, and titlebar color tones
flwm*background:        #3d3d37
flwm*foreground:        #ddd4cc
flwm*activeBackground:  #b7582c
flwm*activeForeground:  #ffffff
