! --- ATERM CONFIG ---
! Controls the terminal scrollbar visibility (set to true to show)
Aterm*scrollBar:        false

! Transparency settings (set 'transparent' to true to enable window opacity)
Aterm*transparent:      false
Aterm*shading:          80

! Basic terminal window settings like default title, font style, and history buffer
Aterm*title:            Terminal
Aterm*font:             fixed
Aterm*saveLines:        2000

! Main text and background colors for the terminal window canvas
Aterm*background:       #FAF8F5
Aterm*foreground:       #270704
Aterm*cursorColor:      #432F25

! Standard ANSI colors (0-7) used for base text highlighting in CLI apps
Aterm*color0:           #270704
Aterm*color1:           #C6695D
Aterm*color2:           #97916F
Aterm*color3:           #CD9165
Aterm*color4:           #6C849C
Aterm*color5:           #A05A78
Aterm*color6:           #856A56
Aterm*color7:           #C3A386

! Bright ANSI colors (8-15) used for bold or high-intensity terminal outputs
Aterm*color8:           #4C433C
Aterm*color9:           #E46A3A
Aterm*color10:          #A5D29D
Aterm*color11:          #E1A61C
Aterm*color12:          #D8B795
Aterm*color13:          #8C747C
Aterm*color14:          #A18363
Aterm*color15:          #D8CEB4

! --- FLTK APPS & SYSTEM UTILITIES ---
! Widget look and feel engine and scaling settings
fltk*scheme:            plastic
*scheme:                plastic
Xft.dpi:                96.0

! Global background, text, and label colors across FLTK window surfaces
*background:            #DECFC6
*foreground:            #270704
*labelcolor:            #270704

! FLTK canvas background for text editors, browsers, and input fields
*background2:           #FAF8F5
*bg2:                   #FAF8F5

! Accent color for selections, marked text, and active controls
*selectColor:           #C6695D
*selection_color:       #C6695D

! Universal component overrides (Dual TitleCase declarations for strict FLTK class parser)
*input*background:      #FAF8F5
*input*foreground:      #270704
*Input*background:      #FAF8F5
*Input*foreground:      #270704
*output*background:     #F3ECE7
*output*foreground:     #270704
*Output*background:     #F3ECE7
*Output*foreground:     #270704
*text*background:       #FAF8F5
*text*foreground:       #270704
*Text*background:       #FAF8F5
*Text*foreground:       #270704
*browser*background:    #FAF8F5
*browser*foreground:    #270704
*Browser*background:    #FAF8F5
*Browser*foreground:    #270704
*Hold_Browser*background: #FAF8F5
*Hold_Browser*foreground: #270704
*Select_Browser*background: #FAF8F5
*Select_Browser*foreground: #270704
*help*background:       #FAF8F5
*help*foreground:       #270704
*Help_View*background:  #FAF8F5
*Help_View*foreground:  #270704
*file_chooser*background: #DECFC6
*file_chooser*foreground: #270704
*File_Chooser*background: #DECFC6
*File_Chooser*foreground: #270704
*scrollbar*background:  #DECFC6
*scrollbar*foreground:  #270704
*Scrollbar*background:  #DECFC6
*Scrollbar*foreground:  #270704
*Scrollbar*color:       #EAE0D8
*Button*background:     #EAE0D8
*Button*foreground:     #270704

! --- FLWM ---
! Window manager frames, borders, and titlebar color tones
flwm*background:        #DECFC6
flwm*foreground:        #270704
flwm*activeBackground:  #C6A69B
flwm*activeForeground:  #270704
